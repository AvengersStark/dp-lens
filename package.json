{
  "name": "dp-lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DP Lens: a step-based tutor for knapsack dynamic programming",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
